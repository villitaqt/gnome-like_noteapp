{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Editor",
  "version": "0.1.0",
  "identifier": "com.diego.gnome-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Text Editor",
        "width": 900,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["txt"], "name": "Text Document" },
      { "ext": ["md", "markdown"], "name": "Markdown Document" },
      {
        "ext": ["js", "ts", "jsx", "tsx", "py", "rs", "go", "json", "yaml", "yml", "toml", "html", "css", "sh", "bash", "zsh", "fish", "c", "cpp", "h", "java", "rb", "php", "swift", "kt", "cs", "lua", "sql"],
        "name": "Source File"
      }
    ]
  }
}
